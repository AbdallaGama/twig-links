{
  "name": "twig-server",
  "version": "0.1.0",
  "description": "Twig: free, self-hosted deep linking, deferred deep linking and link attribution server.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
