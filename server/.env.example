# Node (local dev / self-hosting): export these or use a process manager.
# Cloudflare Workers: put plain values in wrangler.toml [vars] and secrets with
#   npx wrangler secret put ADMIN_PASSWORD
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_PATH=./data/twig.db
# Node behind a reverse proxy only (Workers read CF-Connecting-IP).
TRUST_PROXY=false
# Optional: create the owner on first start instead of using the printed setup token.
# Choose your own values; on Cloudflare set them with `npx wrangler secret put`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Deferred deep linking
MATCH_WINDOW_SECONDS=7200
CLICK_RETENTION_DAYS=30
SDK_RATE_LIMIT_PER_MINUTE=240
