# Copy to .env (or set in your process manager / docker-compose).
PORT=8080
# Public URL of the dashboard + API (used for cookies and generated links when an app has no domain yet).
PUBLIC_URL=https://links-admin.example.com
DATABASE_PATH=./data/twig.db
# Set to true behind Caddy/Nginx/Cloudflare so client IPs and https are detected correctly.
TRUST_PROXY=true
# Optional: create the owner on first start instead of using the printed setup token.
# The values below are for LOCAL DEVELOPMENT ONLY — never reuse them in production.
ADMIN_EMAIL=admin@twig.local
ADMIN_PASSWORD=twig-local-dev-password
# Deferred deep linking
MATCH_WINDOW_SECONDS=7200
CLICK_RETENTION_DAYS=30
SDK_RATE_LIMIT_PER_MINUTE=240
