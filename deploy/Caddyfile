{
	email {$ACME_EMAIL}
	on_demand_tls {
		# Twig answers 200 only for registered link domains and the dashboard host.
		ask http://twig:8080/caddy/ask
	}
}

# Dashboard + API host.
{$TWIG_ADMIN_HOST} {
	encode gzip
	reverse_proxy twig:8080
}

# Every link domain you add in the dashboard (point its DNS here) gets a certificate on first request.
https:// {
	tls {
		on_demand
	}
	reverse_proxy twig:8080
}

http:// {
	redir https://{host}{uri} permanent
}
